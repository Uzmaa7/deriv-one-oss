# Written by the platform setup wizard or `npm run setup`. Restart the backend to apply.
# Copy to platform.env and run setup — do not commit platform.env.

APP_BASE_URL=http://localhost:3000
APP_ENV=development
APP_LOGO_URL=/app-logo-icon.svg
APP_NAME="Your Platform"
APP_SHORT_NAME="Your Platform"
BRAND_COLOR="#FF444F"
BRAND_COLOR_HOVER="#e03d47"
BRAND_COLOR_SOFT="#FFF0F0"
DIRECTORY_PROVIDER=claims
ENABLE_MOCK_AUTH=true
MOCK_USER_EMAIL=admin@example.com
MOCK_USER_GROUPS=platform-admins,platform-users
# Optional for LM Studio / Ollama on localhost (e.g. http://127.0.0.1:1234).
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_URL=http://localhost:4000
# Local gateway tuning (LM Studio default context is often 4096):
# LOCAL_GATEWAY_CONTEXT_LIMIT=4096
# LOCAL_GATEWAY_MAX_OUTPUT_TOKENS=1024
# Optional comma-separated allowlist for all users (LM Studio / Ollama ids):
# WORKSPACE_ENABLED_MODELS=openai/gpt-oss-20b
ORG_NOUN=employee
PLATFORM_SETUP_COMPLETE=0
RESOURCE_PREFIX=platform
SECRET_ENCRYPTION_KEY=
