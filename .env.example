# Platform — frontend build configuration
#
# Only values that must be baked into the built assets belong here. Everything
# else is backend configuration; see backend/.env.example.

# Public base URL of this deployment.
APP_URL=http://localhost:8080

# Development only: a pre-issued token to send with API requests when the UI is
# not running behind your identity provider. Expires quickly, and baking one
# into a production build would ship a credential to every visitor.
# VITE_AUTH_TOKEN=
